# Public URL of the deployed site — used for canonical URLs, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: send contact-form messages by email through Resend (https://resend.com).
# Without RESEND_API_KEY the form falls back to opening a prefilled mailto: link.
RESEND_API_KEY=
# Where messages are delivered (defaults to the email in src/content/profile.ts).
CONTACT_TO_EMAIL=
# Verified sender address in Resend (defaults to "Portfolio <onboarding@resend.dev>").
CONTACT_FROM_EMAIL=
